{
  "name": "repository-tasks",
  "sourceRoot": "tools/nx-plugins/repository-tasks/src",
  "projectType": "library",
  "tags": ["type:tooling"],
  "targets": {
    "dependabot": {
      "executor": "@wortlaut/repository-tasks:dependabot",
      "cache": false,
      "options": {
        "mode": "merge"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "node --test --test-concurrency=1 \"tools/nx-plugins/repository-tasks/src/executors/dependabot/*.spec.mjs\"",
          "vitest run --config tools/nx-plugins/repository-tasks/vitest.config.ts"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "tools/nx-plugins/repository-tasks",
        "command": "eslint ."
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/nx-plugins/repository-tasks/tsconfig.json --noEmit"
      }
    },
    "ci-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["test"],
      "options": {
        "command": "node --test --test-concurrency=1 \"tools/workspace/*.spec.mjs\" \".github/scripts/*.spec.mjs\""
      }
    }
  }
}
