{
  "name": "@pixel-brewery/wortlaut-desktop",
  "description": "Wortlaut desktop app: Electron main and sandboxed preload",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
