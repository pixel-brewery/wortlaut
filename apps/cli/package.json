{
  "name": "@pixel-brewery/wortlaut-app",
  "description": "Wortlaut app/cli",
  "version": "0.2.2",
  "license": "MIT",
  "author": "Pixel Brewery (https://github.com/pixel-brewery)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-brewery/wortlaut.git",
    "directory": "apps/cli"
  },
  "type": "commonjs",
  "main": "./dist/Index.js",
  "commonjs": "./dist/Index.js",
  "module": "./dist/Index.js",
  "types": "./dist/Index.d.ts",
  "bin": {
    "localizator": "./dist/bin/wortlaut.js",
    "wortlaut": "./dist/bin/wortlaut.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mjs",
    "lint": "eslint \"src/**/*.ts\" --quiet",
    "clean": "rimraf ./dist ./.cache"
  },
  "dependencies": {
    "@pixel-brewery/synapse-core": "0.0.3",
    "@pixel-brewery/synapse-provider-claude": "0.0.3",
    "@pixel-brewery/synapse-provider-codex": "0.0.3",
    "@pixel-brewery/synapse-provider-opencode": "0.0.3",
    "@pixel-brewery/synapse-runtime": "0.0.3",
    "@pixel-brewery/utilities": "0.1.187",
    "@pixel-brewery/wortlaut-ai": "0.2.2",
    "@pixel-brewery/wortlaut-contracts": "0.2.2",
    "@pixel-brewery/wortlaut-core": "0.2.2",
    "@pixel-brewery/wortlaut-engine": "0.2.2",
    "@pixel-brewery/wortlaut-mcp": "0.2.2",
    "diff": "9.0.0",
    "dir-glob": "3.0.1",
    "es-toolkit": "1.52.0",
    "fast-glob": "3.3.3",
    "fs-extra": "11.4.1",
    "jsonc-parser": "3.3.1",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@pixel-brewery/eslint-config": "0.1.187",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "nx": {
    "includedScripts": []
  }
}
