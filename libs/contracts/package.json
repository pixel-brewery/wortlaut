{
  "name": "@pixel-brewery/wortlaut-contracts",
  "description": "Wortlaut contracts: Zod schemas and types for runs, change sets and settings",
  "version": "0.2.7",
  "license": "MIT",
  "author": "Pixel Brewery (https://github.com/pixel-brewery)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-brewery/wortlaut.git",
    "directory": "libs/contracts"
  },
  "type": "commonjs",
  "main": "./dist/Index.js",
  "commonjs": "./dist/Index.js",
  "module": "./dist/Index.js",
  "types": "./dist/Index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mjs",
    "lint": "eslint \"src/**/*.ts\" --quiet",
    "clean": "rimraf ./dist ./.cache"
  },
  "dependencies": {
    "tslib": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pixel-brewery/eslint-config": "0.1.187",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "nx": {
    "includedScripts": []
  }
}
