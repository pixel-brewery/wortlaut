{
  "name": "frontend-feature-detect",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/frontend/features/detect/src",
  "tags": ["runtime:frontend", "kind:feature"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/frontend/features/detect/tsconfig.lib.json"
      },
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/libs/frontend/features/detect"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project libs/frontend/features/detect/tsconfig.lib.json --noEmit --emitDeclarationOnly false"
      },
      "dependsOn": ["^build"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "eslint \"src/**/*.ts\" --quiet"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config tools/testing/frontend.vitest.config.mjs libs/frontend/features/detect"
      },
      "cache": true,
      "dependsOn": ["^build"]
    }
  }
}
