  },
  "dependencies": {
    "@ai-sdk/google": "4.0.102",
    "@ai-sdk/openai": "4.0.99",
    "@pixel-brewery/synapse-auth": "0.0.3",
    "@pixel-brewery/synapse-core": "0.0.3",
    "@pixel-brewery/synapse-provider-claude": "0.0.3",
    "@pixel-brewery/synapse-provider-codex": "0.0.3",
    "@pixel-brewery/synapse-provider-opencode": "0.0.3",
    "@pixel-brewery/synapse-runtime": "0.0.3",
    "@pixel-brewery/utilities": "0.1.187",
    "@pixel-brewery/wortlaut-core": "0.2.4",
    "@toon-format/toon": "4.4.0",
    "ai": "7.0.148",
    "dir-glob": "3.0.1",
    "es-toolkit": "1.52.0",
    "fast-glob": "3.3.3",
    "fs-extra": "11.4.1",
    "jsonc-parser": "3.3.1",
    "tslib": "2.8.1",
    "zod": "4.6.7"
