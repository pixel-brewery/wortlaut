{
  "name": "@pixel-brewery/wortlaut-nx-tasks",
  "description": "Wortlaut for Nx: the executor that runs detect, analyze, transform, sort and generate as a target",
  "version": "0.2.7",
  "license": "MIT",
  "author": "Pixel Brewery (https://github.com/pixel-brewery)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-brewery/wortlaut.git",
    "directory": "libs/backend/nx-tasks"
  },
  "type": "commonjs",
  "main": "./dist/Index.js",
  "commonjs": "./dist/Index.js",
  "module": "./dist/Index.js",
  "types": "./dist/Index.d.ts",
  "executors": "./executors.json",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mjs",
    "lint": "eslint \"src/**/*.ts\" --quiet",
    "clean": "rimraf ./dist ./.cache"
  },
  "dependencies": {
    "@pixel-brewery/utilities": "0.1.187",
    "@pixel-brewery/wortlaut-app": "0.2.7",
    "dotenv": "18.0.8",
    "dotenv-expand": "1000.0.0",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "@nx/devkit": ">=22.0.0"
  },
  "peerDependenciesMeta": {
    "@nx/devkit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nx/devkit": "24.0.0",
    "@pixel-brewery/eslint-config": "0.1.187",
    "@types/node": "26.6.5",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "executors.json",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "nx": {
    "includedScripts": []
  }
}
