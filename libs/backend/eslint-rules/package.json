{
  "name": "@pixel-brewery/wortlaut-eslint-rules",
  "description": "Wortlaut for ESLint: the rules that check translation catalogs while linting",
  "version": "0.2.4",
  "license": "MIT",
  "author": "Pixel Brewery (https://github.com/pixel-brewery)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixel-brewery/wortlaut.git",
    "directory": "libs/backend/eslint-rules"
  },
  "type": "commonjs",
  "main": "./dist/Index.js",
  "commonjs": "./dist/Index.js",
  "module": "./dist/Index.js",
  "types": "./dist/Index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.mjs",
    "lint": "eslint \"src/**/*.ts\" --quiet",
    "clean": "rimraf ./dist ./.cache"
  },
  "dependencies": {
    "@pixel-brewery/utilities": "0.1.187",
    "@pixel-brewery/wortlaut-core": "0.2.4",
    "tslib": "2.8.1"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript-eslint": ">=8.0.0"
  },
  "devDependencies": {
    "@eslint/json": "2.1.1",
    "@pixel-brewery/eslint-config": "0.1.187",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "jsonc-eslint-parser": "3.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "nx": {
    "includedScripts": []
  }
}
